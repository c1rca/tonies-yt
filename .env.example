# App (Docker Compose defaults; native runs should use DATA_DIR=./data)
APP_PORT=8080
DATA_DIR=/app/data

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=/app/data/logs/toni-auto.log

# Tonies account credentials normally live in the app's encrypted local vault.
# Optional legacy environment credentials take precedence over the vault.
# Do not commit populated credentials or share .env files.
# TONIES_EMAIL=
# TONIES_PASSWORD=

# Tonies uses direct OAuth + HTTP API requests, with tokens renewed in memory.
# No browser selectors or persisted browser session are required.
