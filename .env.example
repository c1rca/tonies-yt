# Docker Compose: loopback only. Complete setup locally before opting into LAN.
TONIES_BIND_ADDRESS=127.0.0.1
TONIES_PORT=8090

# Container paths are fixed by Compose; native runs use DATA_DIR=./data instead.
APP_PORT=8080
DATA_DIR=/app/data
LOG_LEVEL=INFO
LOG_FILE=/app/data/logs/toni-auto.log

# Trusted browser Host names/IPs (no scheme, path or port). Add your exact LAN
# address/hostname before remote use; never use '*' as a convenience workaround.
APP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Per-file upload ceiling: 100 MiB (request limit also allows multipart overhead).
APP_MAX_UPLOAD_BYTES=104857600
# Optional canonical HTTPS browser origin when using a reverse proxy.
# APP_PUBLIC_URL=https://tonies.example.com

# Tonies credentials normally live in the app's encrypted local vault.
# Environment overrides are plaintext to Docker admins; you still need app login.
# Do not commit populated credentials or share .env files.
# TONIES_EMAIL=
# TONIES_PASSWORD=
